<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_axoline_layout_custom_tree" model="ir.ui.view">
        <field name="name">axoline.layout.custom.list</field>
        <field name="model">axoline.layout.custom</field>
        <field name="arch" type="xml">
            <list string="Saved Layouts">
                <field name="name"/>
                <field name="model_name"/>
                <field name="report_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_axoline_layout_custom_form" model="ir.ui.view">
        <field name="name">axoline.layout.custom.form</field>
        <field name="model">axoline.layout.custom</field>
        <field name="arch" type="xml">
            <form string="PDF Layout">
                <header>
                    <button string="Open Visual Editor" type="object"
                            name="action_open_visual_editor"
                            class="btn-primary" icon="fa-object-group"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="report_id" readonly="1"/>
                            <field name="model_name"/>
                            <field name="report_name"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Editor Data (JSON)" name="layout_json">
                            <field name="layout_json" widget="text" nolabel="1"
                                   placeholder='{"version": 1, "blocks": []}'/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_axoline_layout_custom" model="ir.actions.act_window">
        <field name="name">Saved Layouts</field>
        <field name="res_model">axoline.layout.custom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No layouts created yet.
            </p>
            <p>
                Open <strong>PDF Reports</strong> and click <strong>Layout</strong>
                to create a layout in the visual editor.
            </p>
        </field>
    </record>
</odoo>
