<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_axoline_layout_template_tree" model="ir.ui.view">
        <field name="name">axoline.layout.template.tree</field>
        <field name="model">axoline.layout.template</field>
        <field name="arch" type="xml">
            <list string="Layout Templates" delete="false">
                <field name="sequence" widget="handle"/>
                <field name="axoline_is_locked" column_invisible="1"/>
                <field name="name"/>
                <field name="category"/>
                <field name="is_system"/>
                <field name="active"/>
                <button name="action_axoline_open_pro_store" type="object" string="🔒 PRO"
                        title="This template is available in the Axoline Layout Editor PRO add-on. Click to open the App Store."
                        class="btn-link text-warning fw-bold"
                        invisible="not axoline_is_locked"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_axoline_layout_template_form" model="ir.ui.view">
        <field name="name">axoline.layout.template.form</field>
        <field name="model">axoline.layout.template</field>
        <field name="arch" type="xml">
            <form string="Layout Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_system" invisible="1"/>
                        <field name="axoline_is_locked" invisible="1"/>
                        <button name="action_open_visual_editor"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="is_system"
                                string="Edit in Editor"/>
                        <button name="action_axoline_open_pro_store"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-lock"
                                invisible="not axoline_is_locked">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text text-warning">Unlock with PRO</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="PRO Template"
                            invisible="not axoline_is_locked"
                            bg_color="text-bg-warning"/>
                    <widget name="web_ribbon" title="System Template (read-only)"
                            invisible="is_system and axoline_is_locked or not is_system"
                            bg_color="text-bg-info"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name"
                                   readonly="is_system"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" readonly="is_system"/>
                            <field name="active" readonly="is_system"/>
                            <field name="sequence" readonly="is_system"/>
                        </group>
                        <group>
                            <field name="thumbnail" widget="image" readonly="is_system"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="is_system"/>
                    </group>
                    <group invisible="not axoline_is_locked">
                        <div class="alert alert-warning mb-0" role="alert">
                            <i class="fa fa-lock me-2"/>
                            <span>This template's design is part of the Axoline Layout Editor PRO add-on.</span>
                            <button name="action_axoline_open_pro_store" type="object"
                                    class="btn btn-warning btn-sm ms-2">Get the PRO add-on</button>
                        </div>
                    </group>
                    <group invisible="axoline_is_locked">
                        <field name="layout_json" widget="ace" options="{'mode': 'json'}"
                               readonly="is_system"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_axoline_layout_template" model="ir.actions.act_window">
        <field name="name">Layout Templates</field>
        <field name="res_model">axoline.layout.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No layout templates available yet
            </p>
            <p>
                Create reusable templates for your PDF report layouts.
            </p>
        </field>
    </record>

</odoo>
