<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_form_warehouse_readonly" model="ir.ui.view">
        <field name="name">sale.order.form.warehouse.readonly</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Make Warehouse read-only -->
            <xpath expr="//field[@name='warehouse_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

        </field>
    </record>
	<record id="view_order_form_inherit_pricelist_limit" model="ir.ui.view">
    <field name="name">sale.order.form.pricelist.limit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

        <field name="pricelist_id" position="attributes">
            <attribute name="domain">
                [(user.allowed_journal_ids.mapped(
                'x_available_pricelist_ids'
            ))]
            </attribute>
        </field>

    </field>
</record>

</odoo>
