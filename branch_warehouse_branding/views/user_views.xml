<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_users_form_inherit" model="ir.ui.view">
            <field name="name">res.users.form.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <group string="Branch Branding Restrictions">
                        <field name="allowed_journal_ids" widget="many2many_tags"/>
                        <field name="x_default_sales_journal_id" string="Default Sales Journal"/>
                        <field name="x_default_sales_team_id" string="Default Sales Team"/>
                       
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
