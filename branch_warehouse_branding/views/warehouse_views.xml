<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_warehouse_inherit_branding" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit.branding</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="branch_logo" widget="image" class="oe_avatar"/>
                    <field name="branch_name" placeholder="Enter Branch Name in English..."/>
                    <field name="branch_address" placeholder="Enter address for invoices..."/>
                    <field name="branch_logo_ar" widget="image" clasee="oe_avatar"/>
                    <field name="branch_name_ar" placeholder="Enter Branch Name in Arabic"/>
                    <field name="branch_address_ar" placeholde="Enter Branch Name in Arabic"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
