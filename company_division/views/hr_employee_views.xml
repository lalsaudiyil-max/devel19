<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_hr_employee_division_form_inherit" model="ir.ui.view">
            <field name="name">hr.employee.division.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form//field[@name='parent_id']" position="after">
                  <field name="division_id" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
