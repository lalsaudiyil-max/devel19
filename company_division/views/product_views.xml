<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="view_product_template_form_division" model="ir.ui.view">
        <field name="name">product.template.form.division</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form[@name='Product Template']//field[@name='type']" position="after">
              <field name="internal_quality"/>
              <field name="division_id"/>
            </xpath>
       </field>
    </record>
</odoo>
