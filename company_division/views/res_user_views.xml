<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_res_users_form_division_inherit" model="ir.ui.view">
            <field name="name">res.users.form.division.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
               <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Division">
                  <field name="division_id" widget="many2many_tags" string="Division"/>
                </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
