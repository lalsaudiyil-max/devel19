<odoo>
    <template id="daily_payment_report">

        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">

                    <h2 class="text-center">
                        Daily Invoice &amp; Payment Report
                    </h2>

                    <p>
                      <h3>  <strong>Branch:</strong>
                        <t t-esc="target_user_name"/></h3>
                          <br/>

                        <strong>From:</strong>
                        <t t-esc="date_from"/><br/>

                        <strong>To:</strong>
                        <t t-esc="date_to"/>
                    </p>

                <!-- INVOICES -->
                <h3>Invoices Summary</h3>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Customer Type</th>
                            <th>Untaxed</th>
                            <th>Tax</th>
                            <th>Total</th>
                        </tr>
                     </thead>
                    <tbody>
                        <tr>    
                            <td>Cash</td>
                            <td><t t-esc="invoice_summary['cash_untaxed']"/></td>
                            <td><t t-esc="invoice_summary['cash_tax']"/></td>
                            <td><t t-esc="invoice_summary['cash_total']"/></td>
                        </tr>
                        <tr>
                            <td>Credit</td>
                            <td><t t-esc="invoice_summary['credit_untaxed']"/></td>
                            <td><t t-esc="invoice_summary['credit_tax']"/></td>
                            <td><t t-esc="invoice_summary['credit_total']"/></td>
                        </tr>
                    </tbody>
                </table>
                
                 <h4>Cash Invoices</h4>
                 <table class="table table-sm o_cash_table">
          <thead>
        <tr>
            <th>Date</th>
            <th>Invoice Number</th>
            <th>Customer</th>
            <th class="text-right">Untaxed Amount</th>
            <th class="text-right">VAT Amount</th>
            <th class="text-right">Total Amount</th>
        </tr>
    </thead>
                <tbody>
               
                <t t-foreach="invoice_data['cash']" t-as="inv">
                    <tr>
                <td><span t-field="inv.invoice_date" t-options="{'widget': 'date'}"/></td>
                <td><span t-field="inv.name"/></td>
                <td><span t-field="inv.partner_id.name"/></td>
                <td class="text-end"><span t-field="inv.amount_untaxed_signed"/></td>
                <td class="text-end"><span t-field="inv.amount_tax_signed"/></td>
                <td class="text-end"><span t-field="inv.amount_total_signed"/></td>
            </tr>
                </t>
</tbody>
                  </table>
                <h4>Credit Invoices</h4>
                 <table class="table table-sm o_credit_table">
                 <thead>
        <tr>
            <th>Date</th>
            <th>Invoice Number</th>
            <th>Customer</th>
            <th class="text-end">Untaxed Amount</th>
            <th class="text-end">VAT Amount</th>
            <th class="text-end">Total Amount</th>
        </tr>
    </thead>
                <tbody>
                <t t-foreach="invoice_data['credit']" t-as="inv">
                   <tr>
                <td><span t-field="inv.invoice_date" t-options="{'widget': 'date'}"/></td>
                <td><span t-field="inv.name"/></td>
                <td><span t-field="inv.partner_id.name"/></td>
                <td class="text-end"><span t-field="inv.amount_untaxed_signed"/></td>
                <td class="text-end"><span t-field="inv.amount_tax_signed"/></td>
                <td class="text-end"><span t-field="inv.amount_total_signed"/></td>
            </tr>
                </t>
                     </tbody>
                  </table>
                      <h3>Invoice Journal Summary</h3>
                <table class="table table-sm">
    <thead>
        <tr>
            <th>Journal</th>
            <th class="text-end">Cash Untaxed</th>
            <th class="text-end">Cash VAT</th>
            <th class="text-end">Cash Total</th>

            <th class="text-end">Credit Untaxed</th>
            <th class="text-end">Credit VAT</th>
            <th class="text-end">Credit Total</th>

            <th class="text-end">Grand Total</th>
            <th class="text-end">Invoices</th>
        </tr>
    </thead>

    <tbody>
        <t t-foreach="invoice_by_journal.items()" t-as="j">
            <tr>
                <td><t t-esc="j[0]"/></td>

                <td class="text-end"><t t-esc="j[1]['cash_untaxed']"/></td>
                <td class="text-end"><t t-esc="j[1]['cash_tax']"/></td>
                <td class="text-end"><t t-esc="j[1]['cash_total']"/></td>

                <td class="text-end"><t t-esc="j[1]['credit_untaxed']"/></td>
                <td class="text-end"><t t-esc="j[1]['credit_tax']"/></td>
                <td class="text-end"><t t-esc="j[1]['credit_total']"/></td>

                <td class="text-end"><t t-esc="j[1]['total']"/></td>

                <td class="text-end"><t t-esc="j[1]['count']"/></td>
            </tr>
        </t>
    </tbody>
</table>

                <!-- PAYMENTS -->
                <h3>Payments</h3>
                <!-- looping over dictionary yields keys (ptype) -->
                <!-- ========================================== -->
<!-- 1. CASH PAYMENTS TABLE                     -->
<!-- ========================================== -->
<table class="table table-sm o_main_table">
    <thead>
        <tr>
            <th style="width: 12%;">Date</th>
            <th style="width: 23%;">Customer</th>
            <th style="width: 20%;">Payment Method</th>
            <th style="width: 30%;">Narration / Memo</th>
            <th style="width: 15%;" class="text-end">Amount</th>
        </tr>
    </thead>
    <tbody>
        <!-- Loop through our newly detailed list matrix -->
        <t t-foreach="payment_data['cash']" t-as="pay_line">
            <tr>
                <td><span t-esc="pay_line['date']"/></td>
                <!-- 1. Render the customer name key -->
                <td><span t-esc="pay_line['customer']"/></td>
                <td><span t-esc="pay_line['journal']"/></td>
                <td><span t-esc="pay_line['memo']" class="text-muted"/></td>
                <td class="text-end">
                    <span t-esc="pay_line['amount']" 
                          t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                </td>
            </tr>
        </t>
        <t t-if="not payment_data['cash']">
            <tr>
                <td colspan="5" class="text-center text-muted">No cash payments recorded.</td>
            </tr>
        </t>
    </tbody>
</table>

<!-- ========================================== -->
<!-- 2. CREDIT PAYMENTS TABLE                   -->
<!-- ========================================== -->
<table class="table table-sm o_main_table">
    <thead>
        <tr>
            <th style="width: 12%;">Date</th>
            <th style="width: 23%;">Customer</th>
            <th style="width: 20%;">Payment Method</th>
            <th style="width: 30%;">Narration / Memo</th>
            <th style="width: 15%;" class="text-end">Amount</th>
        </tr>
    </thead>
    <tbody>
        <!-- Loop through our newly detailed list matrix -->
        <t t-foreach="payment_data['credit']" t-as="pay_line">
            <tr>
                <td><span t-esc="pay_line['date']"/></td>
                <!-- 1. Render the customer name key -->
                <td><span t-esc="pay_line['customer']"/></td>
                <td><span t-esc="pay_line['journal']"/></td>
                <td><span t-esc="pay_line['memo']" class="text-muted"/></td>
                <td class="text-end">
                    <span t-esc="pay_line['amount']" 
                          t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                </td>
            </tr>
        </t>
        <t t-if="not payment_data['credit']">
            <tr>
                <td colspan="5" class="text-center text-muted">No credit payments recorded.</td>
            </tr>
        </t>
    </tbody>
</table>
                
            </div>
        </t>
     </t>
    </template>
</odoo>
