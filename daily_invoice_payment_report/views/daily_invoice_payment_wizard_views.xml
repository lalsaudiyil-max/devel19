<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_daily_invoice_payment_wizard_form"
            model="ir.ui.view">

        <field name="name">
            daily_invoice_payment_wizard_form
        </field>

        <field name="model">daily.invoice.payment.wizard</field>

        <field name="arch" type="xml">

            <form string="Daily Invoice Payment Report">

                <group>

                    <field name="user_id"/>

                    <field name="company_id"/>

                    <field name="date_from"/>

                    <field name="date_to"/>

                </group>

                <footer>

                    <button
                        name="action_print"
                        type="object"
                        string="Print"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>

    <record id="action_daily_invoice_payment_wizard"
            model="ir.actions.act_window">

        <field name="name">Daily Invoice Payment Report</field>

        <field name="res_model">daily.invoice.payment.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>

    <menuitem
        id="menu_daily_invoice_payment_report"
        name="Daily Invoice Payment Report"
        parent="account.menu_finance_reports"
        action="action_daily_invoice_payment_wizard"
        sequence="100"
    />

</odoo>
