<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="act_report_xml_view_form_axoline" model="ir.ui.view">
        <field name="name">ir.actions.report.form.axoline</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="axoline_is_locked" invisible="1"/>
                <button name="action_axoline_open_layout_editor" type="object"
                        invisible="report_type != 'qweb-pdf' or axoline_is_locked"
                        class="oe_stat_button" icon="fa-object-group"
                        groups="axoline_layout_editor.group_axoline_layout_editor">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Layout Editor</span>
                    </div>
                </button>
                <button name="action_axoline_open_pro_store" type="object"
                        invisible="not axoline_is_locked"
                        class="oe_stat_button" icon="fa-lock"
                        groups="axoline_layout_editor.group_axoline_layout_editor">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text text-warning">Unlock with PRO</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="act_report_xml_view_tree_axoline" model="ir.ui.view">
        <field name="name">ir.actions.report.list.axoline</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="axoline_is_locked" column_invisible="1"/>
                <button name="action_axoline_open_layout_editor" type="object" string="Layout"
                        title="Edit layout in Axoline Editor"
                        class="btn-link"
                        invisible="report_type != 'qweb-pdf' or axoline_is_locked"
                        groups="axoline_layout_editor.group_axoline_layout_editor"/>
                <button name="action_axoline_open_pro_store" type="object" string="🔒 PRO"
                        title="This document type requires the Axoline Layout Editor PRO add-on. Click to open the App Store."
                        class="btn-link text-warning fw-bold"
                        invisible="not axoline_is_locked"
                        groups="axoline_layout_editor.group_axoline_layout_editor"/>
            </xpath>
        </field>
    </record>

    <record id="action_axoline_pdf_reports" model="ir.actions.act_window">
        <field name="name">PDF Reports</field>
        <field name="res_model">ir.actions.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('report_type', '=', 'qweb-pdf')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No PDF reports found.
            </p>
            <p>
                PDF reports come from installed apps (Sales, Invoicing, Inventory, …).
            </p>
        </field>
    </record>
</odoo>
