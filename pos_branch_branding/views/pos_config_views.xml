<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pos_config_branding_form" model="ir.ui.view">
        <field name="name">pos.config.branding.form</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="POS Branding">

                    <field name="browser_title"/>
                    <field name="branch_logo" widget="image"/>
                    <field name="screensaver_logo" widget="image"/>

                </group>
            </xpath>

        </field>
    </record>

</odoo>