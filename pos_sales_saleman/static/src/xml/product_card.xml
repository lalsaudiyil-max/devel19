<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">

        <!-- ADD PRICING INSIDE PRODUCT CONTENT -->
        <xpath expr="//div[hasclass('product-content')]" position="replace">
<div class="position-absolute top-0 end-0 m-1">
<t t-esc="props.product.name"/>
     </div>
    <t t-set="discount_info" t-value="this.discountData"/>

    <!-- NAME MUST ALWAYS BE FIRST AND ALWAYS VISIBLE -->
    

    <!-- BADGE (kept outside flow but NOT overlapping text) -->
    <t t-if="discount_info and discount_info.hasDiscount">
        <div class="position-absolute top-0 end-0 m-1">
            <span class="badge rounded-circle bg-danger"
                  style="width:42px;height:42px;display:flex;align-items:center;justify-content:center;">
                -<t t-esc="discount_info.discountPercentage"/>
            </span>
        </div>
        
    </t>
    <t t-if="discount_info and discount_info.showDiscountLimit">
        <div class="position-absolute top-0 end-0 m-1">
        <span class="badge rounded-circle bg-success">
            <t t-esc="discount_info.discountLimit"/>%
        </span>
     </div>
    </t>

    <!-- PRICES -->
    <div class="text-center mt-auto w-100">

        <t t-if="discount_info">

            <t t-if="discount_info.hasDiscount">
                <div class="text-decoration-line-through">
                    <t t-esc="discount_info.originalPriceFormatted"/>
                </div>

                <div class="btn btn-primary w-100 fw-bold py-1">
                    <t t-esc="discount_info.currentPriceFormatted"/>
                </div>
            </t>

            <t t-elif="discount_info.showDiscountLimit">
                <div class="btn btn-primary w-100 fw-bold py-1">
                    <t t-esc="discount_info.originalPriceFormatted"/>
                </div>
            </t>

        </t>

        <t t-else="">

            <div class="btn btn-primary w-100 fw-bold py-1">
                <t t-esc="discount_info?.originalPriceFormatted || props.product.list_price"/> SR
            </div>

        </t>

    </div>

</xpath>

    </t>

</templates>
