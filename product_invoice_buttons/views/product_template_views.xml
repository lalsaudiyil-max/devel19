<odoo>
    <record id="view_product_template_form_invoiced_billed" model="ir.ui.view">
        <field name="name">product.template.form.invoiced.billed</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Add smart buttons after the existing Variants button -->
            <xpath expr="//button[@name='action_open_documents']" position="after">
                <!-- Qty Invoiced -->
                <button name="action_view_invoices" type="object" class="oe_stat_button"
                        icon="fa-file-text">
                    <field name="qty_invoiced" widget="statinfo" string="Invoiced Qty"/>
                </button>

                <!-- Qty Billed -->
                <button name="action_view_bills" type="object" class="oe_stat_button"
                        icon="fa-file-text-o">
                    <field name="qty_billed" widget="statinfo" string="Billed Qty"/>
                </button>
            </xpath>

        </field>
    </record>

    <record id="view_product_product_form_invoiced_billed" model="ir.ui.view">
        <field name="name">product.product.form.invoiced.billed</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <!-- Insert buttons next to the top action buttons -->
            <xpath expr="//button[@name='action_open_documents']" position="after">
                <!-- Qty Invoiced -->
                <button name="action_view_invoices" type="object" class="oe_stat_button"
                        icon="fa-file-text">
                    <field name="qty_invoiced" widget="statinfo" string="Invoiced Qty"/>
                </button>

                <!-- Qty Billed -->
                <button name="action_view_bills" type="object" class="oe_stat_button"
                        icon="fa-file-text-o">
                    <field name="qty_billed" widget="statinfo" string="Billed Qty"/>
                </button>
            </xpath>

        </field>
    </record>
</odoo>