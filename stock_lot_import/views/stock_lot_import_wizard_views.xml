<odoo>
    <record id="view_stock_lot_import_wizard" model="ir.ui.view">
        <field name="name">stock.lot.import.wizard.form</field>
        <field name="model">stock.lot.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Inventory Lots">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    
</odoo>
