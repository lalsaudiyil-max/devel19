<odoo>
    <data noupdate="1">
        <record id="module_category_tailoring" model="ir.module.category">
            <field name="name">Tailoring Management</field>
            <field name="description">Category for Tailoring Trading and Factory permissions.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_tailoring_user" model="res.groups">
            <field name="name">Salesman</field>
            <field name="category_id" ref="module_category_tailoring"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_tailoring_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_tailoring"/>
            <field name="implied_ids" eval="[(4, ref('group_tailoring_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_tailoring_order_user" model="ir.rule">
            <field name="name">Salesman: Personal Orders Only</field>
            <field name="model_id" ref="model_tailoring_order"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tailoring_user'))]"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_tailoring_order_manager" model="ir.rule">
            <field name="name">Manager: All Orders</field>
            <field name="model_id" ref="model_tailoring_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tailoring_manager'))]"/>
        </record>
    </data>
</odoo>