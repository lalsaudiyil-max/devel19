<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_tailoring_garment_type" model="ir.actions.act_window">
        <field name="name">Garment Configurations</field>
        <field name="res_model">tailoring.garment.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tailoring_garment_type_form" model="ir.ui.view">
        <field name="name">tailoring.garment.type.form</field>
        <field name="model">tailoring.garment.type</field>
        <field name="arch" type="xml">
            <form string="Garment Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Thobe"/></h1>
                    </div>
                    <notebook>
                        <page string="Metrics (Measurements)" name="metrics">
                            <field name="metric_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Specifications (Features)" name="specs">
                            <field name="spec_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_tailoring_root" 
              name="Tailoring" 
              sequence="10"/>

    <menuitem id="menu_tailoring_order_parent" 
              name="Orders" 
              parent="menu_tailoring_root" 
              sequence="10"/>

    <menuitem id="menu_tailoring_config_root" 
              name="Configuration" 
              parent="menu_tailoring_root" 
              sequence="100"/>

    <menuitem id="menu_garment_types" 
              name="Garment Templates" 
              parent="menu_tailoring_config_root" 
              action="action_tailoring_garment_type" 
              sequence="10"/>
</odoo>