<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="action_report_tailoring_receipt" model="ir.actions.report">
    <field name="name">POS Receipt</field>
    <field name="model">tailoring.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">tailoring_trading.report_tailoring_pos_invoice</field>
    <field name="report_file">tailoring_trading.report_tailoring_pos_invoice</field>
    <field name="print_report_name">'Receipt - %s' % (object.name)</field>
    <field name="binding_model_id" ref="model_tailoring_order"/>
    <field name="binding_type">report</field>
</record>

    <record id="view_tailoring_order_form" model="ir.ui.view">
        <field name="name">tailoring.order.form</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <form string="Tailoring Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    
                    <button name="action_create_invoice" string="Create Tax Invoice" type="object" class="btn-primary" 
                            invisible="state == 'draft' or amt_invoiced == amount_total"/>
                    <button name="%(action_report_tailoring_receipt)d"  string="Print Receipt"  type="action"  class="btn-secondary" icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cut,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_order_count" widget="statinfo" string="Factory POs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cutting_master_id"/>
                            <field name="factory_id"/>
                            <field name="invoice_journal_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total" widget="monetary" string="Total Order"/>
                            <field name="amt_invoiced" widget="monetary" string="Total Billed" 
                                   decoration-danger="amt_invoiced &lt; amount_total" 
                                   decoration-success="amt_invoiced == amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids">
                                <list editable="bottom" default_order="sequence" decoration-muted="parent_line_id != False">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parent_line_id" column_invisible="True"/>
                                    <field name="is_bundle" column_invisible="True"/>
                                    <field name="garment_type_id" column_invisible="True"/>
                                    <field name="fabric_image" widget="image" options="{'size': [64, 64]}" string="Cloth"/>
                                    <field name="fabric_product_id" options="{'no_create': True}"/>
                                    <field name="product_id" attrs="{'readonly': [('parent_line_id', '!=', False)]}"/>
                                    <field name="customer_measurement_id" options="{'no_create': True}"/>
                                    <field name="measurement_summary" attrs="{'readonly': [('parent_line_id', '=', False)]}" optional="show"/>
                                    <button name="action_explode_bundle" type="object" icon="fa-level-down" title="Explode Suit" invisible="not is_bundle or parent_line_id != False"/>
                                    <button name="action_split_lines" type="object" icon="fa-files-o" title="Split Qty" invisible="qty &lt;= 1"/>
                                    <button name="action_show_addons" type="object" icon="fa-plus-square" title="Addons &amp; Details"/>
                                    <field name="qty"/>
                                    <button name="action_send_to_factory" type="object" icon="fa-industry" title="Send to Factory" invisible="production_state != 'approved' or parent_line_id != False" class="text-info"/>
                                    <button name="action_approve_fitting" type="object" icon="fa-check-circle" title="Approve Fitting" invisible="production_state != 'fitting'" class="text-success"/>
                                    <field name="production_state" widget="badge" 
                                           decoration-info="production_state == 'factory'" 
                                           decoration-success="production_state == 'approved'"
                                           decoration-warning="production_state == 'fitting'"/>
                                    <field name="price_unit" readonly="parent_line_id != False"/>
                                    <field name="date_trial"/>
                                    <field name="delivery_date" decoration-bf="1" decoration-warning="not is_delivered"/>
                                    <field name="is_delivered" widget="boolean_toggle"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="tax_id" widget="many2many_tags" options="{'no_create': True}" optional="show"/>
                                    <field name="price_total" string="Total (Inc. VAT)" widget="monetary"/>
                                    <button name="action_locked_info" icon="fa-lock" title="Master is working - Locked" invisible="production_state != 'factory'" class="text-danger" style="pointer-events: none;"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right" name="tailoring_totals">
                     <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                   <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                     <label for="amount_total"/>
                   </div>
                      <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
        
                      <field name="amt_invoiced" string="Already Billed" widget="monetary"/>
                     <field name="balance_due" string="Balance to Pay/Refund" 
                     decoration-danger="balance_due > 0" 
                     decoration-info="balance_due &lt; 0"
                     widget="monetary"/>
                   </group>
                    <div class="oe_clear"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tailoring_order" model="ir.actions.act_window">
        <field name="name">Tailoring Orders</field>
        <field name="res_model">tailoring.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first tailoring order!</p>
        </field>
    </record>

<record id="view_tailoring_order_line_addon_form" model="ir.ui.view">
    <field name="name">tailoring.order.line.addon.form</field>
    <field name="model">tailoring.order.line</field>
    <field name="arch" type="xml">
        <form string="Addons and Workshop Details">
            <sheet>
                <group>
                    <group string="Workshop Details">
                        <field name="customer_measurement_id" readonly="1"/>
                        <field name="measurement_summary" widget="text"/>
                    </group>
                    <group string="Production Notes">
                        <field name="trial_adjustment_notes"/>
                        <field name="production_state"/>
                    </group>
                </group>
                <notebook>
                    <page string="Addons (Extra Charges)">
                        <field name="addon_line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="qty"/>
                                <field name="price_unit"/>
                                <field name="price_total" sum="Total Addons"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </sheet>
        </form>
    </field>
</record>
    <menuitem id="menu_tailoring_root" name="Tailoring" web_icon="tailoring_trading,static/description/icon.png" sequence="10"/>
    <menuitem id="menu_tailoring_order" name="Orders" parent="menu_tailoring_root" action="action_tailoring_order" sequence="1"/>
</odoo>