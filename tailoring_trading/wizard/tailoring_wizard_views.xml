<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tailoring_measurement_wizard_form" model="ir.ui.view">
        <field name="name">tailoring.measurement.wizard.form</field>
        <field name="model">tailoring.measurement.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Measurements">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="garment_type_id" readonly="1" options="{'no_open': True}"/>
                        </h2>
                    </div>
                    
                    <group string="Measurements">
                        <field name="metric_line_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="metric_id" readonly="1"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </group>

                    <group string="Design Features">
                        <field name="spec_line_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="spec_id" readonly="1"/>
                                <field name="value_id" options="{'no_create': True}"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" string="Save Measurements" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>