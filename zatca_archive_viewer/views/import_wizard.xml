<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================== -->
    <!-- WIZARD FORM VIEW -->
    <!-- ================================================== -->
    <record id="view_zatca_import_wizard_form" model="ir.ui.view">
        <field name="name">zatca.import.wizard.form</field>
        <field name="model">zatca.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Odoo 14 Import">
                <group>
                    <group string="Date Range Filters">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Source Filters">
                        <field name="journal_name" placeholder="e.g. Customer Invoices"/>
                    </group>
                </group>
                <footer>
                    <button string="Start Import" name="action_execute_import" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================== -->
    <!-- WIZARD WINDOW ACTION -->
    <!-- ================================================== -->
    <record id="action_zatca_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Data Filter</field>
        <field name="res_model">zatca.import.wizard</field>
        <field name="view_mode">form</field>
        <!-- 'new' tells Odoo to pop this view out inside a modal layout box -->
        <field name="target">new</field>
    </record>

    <!-- ================================================== -->
    <!-- UPDATE YOUR EXISTING IMPORT MENU -->
    <!-- ================================================== -->
    <!-- We change your old menu action to target this interactive wizard instead -->
    <record id="menu_zatca_import" model="ir.ui.menu">
        <field name="action" ref="action_zatca_import_wizard"/>
    </record>
</odoo>